{
  "exe": "benchmark/bin/strata-benchmark",
  "args": [
    "--native",
    "benchmark/weights/Qwen3.8-Flash-Next-UD-IQ4_XS-00001-of-00003.gguf",
    "--pack",
    "benchmark/pack",
    "--max-context",
    "262144",
    "--prefill",
    "16384",
    "--kv",
    "int8",
    "--resident-experts",
    "--expert-profile",
    "benchmark/source/data/expert-profile.bin",
    "--prompt-cache",
    "6",
    "--spec",
    "2"
  ],
  "cwd": "benchmark/source",
  "tokenizer": "benchmark/pack/tokenizer",
  "model_name": "strata-v0.1.40",
  "log": "benchmark/ownership/fidelity/engine.log",
  "host": "127.0.0.1",
  "backend": "hip",
  "repeat_stop_tokens": 0,
  "engine_silence_s": 1800,
  "reasoning_loop_recovery": false,
  "sampling": {
    "temperature": 1,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0,
    "presence_penalty": 0,
    "repetition_penalty": 1,
    "frequency_penalty": 0
  }
}
